# Local application, launcher binaries and personal profile.
/App-*/
/CursorGuard-*/
/Profile/
*.asar
*.asar.official
__pycache__/
*.py[cod]

# Publish only the seven assets used by the current theme.
/ThemeTools/cyberpunk-assets/*
!/ThemeTools/cyberpunk-assets/Cyberpunk/
/ThemeTools/cyberpunk-assets/Cyberpunk/*
!/ThemeTools/cyberpunk-assets/Cyberpunk/Textures/
/ThemeTools/cyberpunk-assets/Cyberpunk/Textures/*
